												<u:FileUploader class="fileUploader" enabled="{ parts : [{path: 'UserData>/recipientGroups/0'},'i18n>Secretaria'], formatter: '.onEnableRol'}" tooltip="Adjuntar Archivo."
													buttonText="{i18n>adjuntar}" buttonOnly="true" change="onChangeFile" icon="sap-icon://attachment"></u:FileUploader>
											</items>
										</HBox>
										<VBox class="colorGray sapUiSmallMarginBottom">
											<items>
												<f:Form editable="true">
													<f:layout>
														<f:ResponsiveGridLayout labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0"
															emptySpanM="0" emptySpanS="0" columnsXL="1" columnsL="1" columnsM="1" singleContainerFullSize="false"/>
													</f:layout>
													<f:formContainers>
														<f:FormContainer>
															<f:formElements>
																<f:FormElement label="{i18n>Fecha}">
																	<f:fields>
																		<DatePicker enabled="{ parts : [{path: 'UserData>/recipientGroups/0'},'i18n>cap_entrenamiento'], formatter: '.onEnableRol'}"
																			dateValue="{HabilitacionModel>/Secretaria_Fecha}" editable="false" displayFormat="dd/MM/yyyy"/>
																		<Label text="{i18n>aclara}:" class="topLabel TextEnd"/>
																		<Input type="Text" value="{HabilitacionModel>/Secretaria_Nombre}" enabled="{ parts : [{path: 'UserData>/recipientGroups/0'},'i18n>cap_entrenamiento'], formatter: '.onEnableRol'}"
																			editable="false"/>
																	</f:fields>
																</f:FormElement>
																<f:FormElement label="{i18n>Firma}">
																	<f:fields>
																		<Image class="signatureBackground" src="{HabilitacionModel>/Secretaria_Firma}" height="70px" width="200px" densityAware="false"/>
																	</f:fields>
																</f:FormElement>
																<f:FormElement label="{i18n>Comentarios}">
																	<f:fields>
																		<TextArea rows="3" value="{SendCommentModel>/SecretGerenciComment}" editable="{EditableCommentsModel>/editMode_secretaria}" />
																	</f:fields>
																</f:FormElement>
															</f:formElements>
														</f:FormContainer>
													</f:formContainers>
												</f:Form>
											</items>
										</VBox>
										<VBox class="colorGray">
											<items>
												<Text text="{i18n>confGerentes}" class="TitleBold mrgLabel"/>
												<f:Form editable="true">
													<f:layout>
														<f:ResponsiveGridLayout labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0"
															emptySpanM="0" emptySpanS="0" columnsXL="1" columnsL="1" columnsM="1" singleContainerFullSize="false"/>
													</f:layout>
													<f:formContainers>
														<f:FormContainer>
															<f:formElements>
																<f:FormElement >
																	<f:fields>
																		<Text text="{i18n>TextOtorgLicencia}" class="topLabel">
																			<layoutData>
																				<l:GridData span="XL9 L9 M9 S12"/>
																			</layoutData>
																		</Text>
																		<Label text="{i18n>Fecha}:" class="TextEnd topLabel paddingTop ">
																			<layoutData>
																				<l:GridData span="XL1 L1 M1 S12"/>
																			</layoutData>
																		</Label>
																		<DatePicker displayFormat="dd/MM/yyyy" dateValue="{HabilitacionModel>/GerRegional_Fecha}" editable="false">
																			<layoutData>
																				<l:GridData span="XL2 L2 M2 S12"/>
																			</layoutData>
																		</DatePicker>
																	</f:fields>
																</f:FormElement>
															</f:formElements>
														</f:FormContainer>
														<f:FormContainer>
															<f:formElements>
																<f:FormElement>
																	<f:fields>
																		<Label text="{i18n>HabValida}" design="Bold" class="topLabel">
																			<layoutData>
																				<l:GridData span="XL3 L3 M3 S12"/>
																			</layoutData>
																		</Label>
																		<DatePicker displayFormat="dd/MM/yyyy" dateValue="{HabilitacionModel>/GerRegional_Fecha_vencimiento}" editable="false">
																			<layoutData>
																				<l:GridData span="XL3 L3 M3 S12"/>
																			</layoutData>
																		</DatePicker>
																		<Label text="{i18n>aclara}:" class="TextEnd topLabel paddingTop ">
																			<layoutData>
																				<l:GridData span="XL3 L3 M3 S12"/>
																			</layoutData>
																		</Label>
																		<Input type="Text" value="{HabilitacionModel>/GerRegional_Nombre}" editable="false">
																			<layoutData>
																				<l:GridData span="XL3 L3 M3 S12"/>
																			</layoutData>
																		</Input>
																	</f:fields>
																</f:FormElement>
																<f:FormElement label="{i18n>Firma}">
																	<f:fields>
																		<Image class="signatureBackground" src="{HabilitacionModel>/GerRegional_Firma}" height="70px" width="200px" densityAware="false"/>
																	</f:fields>
																</f:FormElement>
																<f:FormElement label="{i18n>Comentarios}">
																	<f:fields>
																		<TextArea rows="3" value="{SendCommentModel>/ConfGerReg}" editable="{EditableCommentsModel>/editMode_gerRegional}" />
																	</f:fields>
																</f:FormElement>
															</f:formElements>
														</f:FormContainer>
													</f:formContainers>
												</f:Form>
											</items>
										</VBox>
									</items>
									<layoutData/>
								</VBox>
							</IconTabFilter>
							<IconTabFilter text="{i18n>Adjuntos}">
								<VBox busy="{HabilitacionModel>/Busy}" busyIndicatorDelay="0" visible="{ parts : [{path: 'UserJsonModelVISTA>/User/0/roles'} ], formatter: '.SaveAttachmentVisibility'}">
									<HBox justifyContent="SpaceBetween" alignItems="Center">
										<Title level="H1" text="{i18n>AdjDocComp}" />
										<u:FileUploader class="fileUploader" tooltip="{i18n>adjuntar}" buttonText="{i18n>adjuntar}" buttonOnly="true" icon="sap-icon://attachment" change="onChangeFile" sameFilenameAllowed="true" enabled="{ parts : [{path: 'Habilitacion>/Estado'} ], formatter: '.enableOnlyIfStatusDistinctToRevocado'}" ></u:FileUploader>
									</HBox>
								</VBox>								
								<VBox items="{path: 'Intervenciones>/Intervenciones'}" class="sapUiLargeMarginBottom">
									<items>
										<Panel expandable="true" expanded="false" width="auto"
											visible="{ parts : [{path: 'Intervenciones>AdjuntosSet'}], formatter: '.validaAjuntos'}" class="sapUiResponsiveMargin customPanel">
											<headerToolbar>
												<Toolbar height="45px">
													<Title titleStyle="H4" text="{Intervenciones>Rol} - {Intervenciones>Nombre}"/>
													<ToolbarSpacer/>
													<Text text="{ parts : [{path: 'Intervenciones>Fechaint'},{path: 'Intervenciones>Horaint'}], formatter: '.formatDateTime'}"/>
												</Toolbar>
											</headerToolbar>
											<content>
												<Title titleStyle="H5" text="{i18n>Adjuntos}:"/>
												<VBox items="{path: 'Intervenciones>AdjuntosSet/results'}">
													<items>
														<Link text="{Intervenciones>Nombre} " press="handleLinkAdjuntoPress"/>
													</items>
												</VBox>
											</content>
										</Panel>
									</items>
								</VBox>
							</IconTabFilter>
							<IconTabFilter key="Comentarios" text="{i18n>Comentarios}">
								<Table items="{path: 'ComentariosHabilitacionesModel>/results'}" noDataText="{i18n>noDataText}">
									<columns>
										<Column vAlign="Middle">
											<Text text="{i18n>Rol}"/>
										</Column>
										<Column vAlign="Middle">
											<Text text="{i18n>Comentarios}"/>
										</Column>
									</columns>
									<items>
										<ColumnListItem>
											<cells>
												<Text text="{ path: 'ComentariosHabilitacionesModel>Rol', formatter: '.RolFormatter'}" />
												<Text text="{ComentariosHabilitacionesModel>Comentarios}"/>
											</cells>
										</ColumnListItem>
									</items>
								</Table>
							</IconTabFilter>
							<IconTabFilter key="Estado" text="{i18n>CambioEstado}">
								<Table items="{path: 'MotivoCambioEstadoModel>/results'}" noDataText="{i18n>noDataText}">
									<columns>
										<Column vAlign="Middle">
											<Text text="{i18n>Fecha}"/>
										</Column>
										<Column hAlign="Begin" vAlign="Middle">
											<Text text="{i18n>Rol}"/>
										</Column>
										<Column hAlign="Center" vAlign="Middle">
											<Text text="{i18n>Estado}"/>
										</Column>
										<Column hAlign="Center" vAlign="Middle">
											<Text text="{i18n>Comentarios}"/>
										</Column>
									</columns>
									<items>
										<ColumnListItem>
											<cells>
												<Text text="{ parts : [{path: 'MotivoCambioEstadoModel>Fecha'}, {path: 'MotivoCambioEstadoModel>Hora'}], formatter: '.formatDateTime'}"/>
												<Text text="{path: 'MotivoCambioEstadoModel>Rol', formatter: '.RolFormatter'}"/>
												<Text text="{path: 'MotivoCambioEstadoModel>Estado', formatter: '.StatusFormatter' }"/>
												<Text text="{MotivoCambioEstadoModel>Comentarios}"/>
											</cells>
										</ColumnListItem>
									</items>
								</Table>
							</IconTabFilter>
						</items>
					</IconTabBar>
				</content>
				<footer>
					<Toolbar>
						<ToolbarSpacer/>
						<Button icon="sap-icon://notification-2" press="onSaveComment" text="{i18n>GuardarComentario}"/>
						<Button icon="sap-icon://save" press="onChangeStatus" text="{i18n>CambiarEstado}" enabled="{ parts : [{path: 'UserJsonModelVISTA>/User/0/roles'},{path: 'Habilitacion>/Estado'},{path: 'Habilitacion>/Area'} ], formatter: '.onEnableRol2'}"/>
						<Button icon="sap-icon://print" press="onDonwloadHabilitacion" text="{i18n>Imprimir}"/>
					</Toolbar>
				</footer>
			</Page>
		</pages>
	</App>
</mvc:View>