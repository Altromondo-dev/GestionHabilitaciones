<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout">

    <Dialog
        id="dlgDuplicar"
        title="Duplicar Habilitación N° {DuplicarModel>/Idhabilitacion}"
        contentWidth="960px"
        draggable="true"
        resizable="true">

        <content>
            <VBox class="sapUiSmallMargin">

                <!-- Dirección (calculada, solo lectura), región nueva y selector de adjuntos -->
                <f:Form editable="true">
                    <f:layout>
                        <f:ResponsiveGridLayout
                            labelSpanL="5" labelSpanM="5" labelSpanS="12"
                            emptySpanL="0" emptySpanM="0"
                            columnsL="3" columnsM="3" columnsS="1"
                            singleContainerFullSize="false"/>
                    </f:layout>
                    <f:formContainers>
                        <f:FormContainer>
                            <f:formElements>
                                <f:FormElement label="Dirección">
                                    <f:fields>
                                        <!-- La dirección MR/MB se deduce de la sociedad de la original; no es editable -->
                                        <Text text="{DuplicarModel>/DireccionTexto}"/>
                                    </f:fields>
                                </f:FormElement>
                            </f:formElements>
                        </f:FormContainer>
                        <f:FormContainer>
                            <f:formElements>
                                <f:FormElement label="{i18n>textRegion}">
                                    <f:fields>
                                        <ComboBox
                                            selectedKey="{DuplicarModel>/NuevaArea}"
                                            placeholder="Seleccionar región"
                                            items="{path: 'DuplicarModel>/RegionesDestino'}">
                                            <core:Item key="{DuplicarModel>Codigo}" text="{DuplicarModel>Region}"/>
                                        </ComboBox>
                                    </f:fields>
                                </f:FormElement>
                            </f:formElements>
                        </f:FormContainer>
                    </f:formContainers>
                </f:Form>

                <core:HTML content="&lt;hr style='border:none;border-top:1px solid #e5e5e5;margin:8px 0'/&gt;"/>

                <!-- Habilitación origen -->
                <Title text="Habilitación origen" level="H5" titleStyle="H5" class="sapUiSmallMarginBottom"/>
                <f:Form editable="false">
                    <f:layout>
                        <f:ResponsiveGridLayout
                            labelSpanL="5" labelSpanM="5" labelSpanS="12"
                            emptySpanL="0" emptySpanM="0"
                            columnsL="3" columnsM="2" columnsS="1"
                            singleContainerFullSize="false"/>
                    </f:layout>
                    <f:formContainers>
                        <f:FormContainer>
                            <f:formElements>
                                <f:FormElement label="{i18n>Idhabilitacion}">
                                    <f:fields><Text text="{DuplicarModel>/Idhabilitacion}"/></f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>Empresa}">
                                    <f:fields><Text text="{DuplicarModel>/Empresa}"/></f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>Legajo}">
                                    <f:fields><Text text="{DuplicarModel>/Legajo}"/></f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>Nombre}">
                                    <f:fields><Text text="{DuplicarModel>/Nombre} {DuplicarModel>/Apellido}"/></f:fields>
                                </f:FormElement>
                            </f:formElements>
                        </f:FormContainer>
                        <f:FormContainer>
                            <f:formElements>
                                <f:FormElement label="{i18n>Documento}">
                                    <f:fields><Text text="{DuplicarModel>/Documento}"/></f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>Tipo}">
                                    <f:fields><Text text="{DuplicarModel>/Clasehab}"/></f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>func}">
                                    <f:fields><Text text="{DuplicarModel>/Tipohab}"/></f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>textRegion}">
                                    <f:fields><Text text="{DuplicarModel>/Area}"/></f:fields>
                                </f:FormElement>
                            </f:formElements>
                        </f:FormContainer>
                        <f:FormContainer>
                            <f:formElements>
                                <f:FormElement label="{i18n>Base}">
                                    <f:fields><Text text="{DuplicarModel>/Base}"/></f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>VtoDeHab}">
                                    <f:fields><Text text="{path: 'DuplicarModel>/Vigencia', formatter: '.formatFechas'}"/></f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>VtoApto}">
                                    <f:fields><Text text="{path: 'DuplicarModel>/VtoApto', formatter: '.formatFechas'}"/></f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>Estado}">
                                    <f:fields><Text text="{DuplicarModel>/Estado}"/></f:fields>
                                </f:FormElement>
                            </f:formElements>
                        </f:FormContainer>
                    </f:formContainers>
                </f:Form>

                <core:HTML content="&lt;hr style='border:none;border-top:1px solid #e5e5e5;margin:8px 0'/&gt;"/>

                <!-- Nueva habilitación (réplica solo lectura) -->
                <Title text="Nueva habilitación" level="H5" titleStyle="H5" class="sapUiSmallMarginBottom"/>
                <f:Form editable="false">
                    <f:layout>
                        <f:ResponsiveGridLayout
                            labelSpanL="5" labelSpanM="5" labelSpanS="12"
                            emptySpanL="0" emptySpanM="0"
                            columnsL="3" columnsM="2" columnsS="1"
                            singleContainerFullSize="false"/>
                    </f:layout>
                    <f:formContainers>
                        <f:FormContainer>
                            <f:formElements>
                                <f:FormElement label="{i18n>Idhabilitacion}">
                                    <f:fields><Text text="(se asigna al confirmar)" class="sapUiStrongText"/></f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>Empresa}">
                                    <f:fields><Text text="{DuplicarModel>/DestinoEmpresa}"/></f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>Legajo}">
                                    <f:fields><Text text="{DuplicarModel>/Legajo}"/></f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>Nombre}">
                                    <f:fields><Text text="{DuplicarModel>/Nombre} {DuplicarModel>/Apellido}"/></f:fields>
                                </f:FormElement>
                            </f:formElements>
                        </f:FormContainer>
                        <f:FormContainer>
                            <f:formElements>
                                <f:FormElement label="{i18n>Documento}">
                                    <f:fields><Text text="{DuplicarModel>/Documento}"/></f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>Tipo}">
                                    <f:fields><Text text="{DuplicarModel>/Clasehab}"/></f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>func}">
                                    <f:fields><Text text="{DuplicarModel>/Tipohab}"/></f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>textRegion}">
                                    <f:fields><Text text="{DuplicarModel>/NuevaArea}"/></f:fields>
                                </f:FormElement>
                            </f:formElements>
                        </f:FormContainer>
                        <f:FormContainer>
                            <f:formElements>
                                <f:FormElement label="{i18n>Base}">
                                    <f:fields><Text text="{DuplicarModel>/Base}"/></f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>VtoDeHab}">
                                    <f:fields><Text text="{path: 'DuplicarModel>/Vigencia', formatter: '.formatFechas'}"/></f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>VtoApto}">
                                    <f:fields><Text text="{path: 'DuplicarModel>/VtoApto', formatter: '.formatFechas'}"/></f:fields>
                                </f:FormElement>
                                <f:FormElement label="{i18n>Estado}">
                                    <f:fields><Text text="Habilitada"/></f:fields>
                                </f:FormElement>
                            </f:formElements>
                        </f:FormContainer>
                    </f:formContainers>
                </f:Form>

            </VBox>
        </content>

        <beginButton>
            <!-- INI MOD TRNS #XXXXXX - exigir Región / Área seleccionada para habilitar el botón -->
            <Button
                text="Confirmar Duplicado"
                type="Emphasized"
                enabled="{= ${DuplicarModel>/Estado} === 'H' &amp;&amp; !!${DuplicarModel>/NuevaArea} }"
                press=".onConfirmarDuplicar"/>
            <!-- FIN MOD TRNS #XXXXXX -->
        </beginButton>
        <endButton>
            <Button
                text="Cancelar"
                press=".onCancelarDuplicar"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>
